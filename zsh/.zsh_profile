VIM="nvim"

export DOTFILES=$HOME/dotfiles
export STOW_FOLDERS="bin,bash,docker,dunst,git,i3,picom,kitty,tmux,nvim,rofi,zsh"
export EDITOR=$VIM
export BAT_THEME="Dracula"
export ZSH_GIT_FZF_REMOVE_STALLED_BRANCHES="true"

# fix slowness of pastes with zsh-syntax-highlighting.zsh
pasteinit() {
    OLD_SELF_INSERT=${${(s.:.)widgets[self-insert]}[2,3]}
    zle -N self-insert url-quote-magic
}
pastefinish() {
    zle -N self-insert $OLD_SELF_INSERT
}
zstyle :bracketed-paste-magic paste-init pasteinit
zstyle :bracketed-paste-magic paste-finish pastefinish

# muse theme without git_prompt_status (avoids git status --porcelain every prompt)
PROMPT="${FG[117]}%~%{$reset_color%}\$(git_prompt_info)\$(virtualenv_prompt_info) ${FG[077]}ᐅ%{$reset_color%} "

# history
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:complete:z:*' fzf-preview 'ls --color $realpath'

declare -a dotfiles=(
    ".zsh_bindkeys"
    ".bash_aliases"
    ".docker_aliases"
    ".git_aliases"
    ".work_aliases"
)
# source global aliases
for dotfile in "${dotfiles[@]}"
do
    dotfilePath="$HOME/$dotfile"
    if [ -f "$dotfilePath" ] ; then
        source "$dotfilePath"
    else
        echo "Warning: $dotfile not found in $HOME directory."
    fi
done

# fzf
FZF_PREVIEW_OPTS="--preview='bat --style=numbers --color=always --line-range :500 {}'"
# It includes colors from the Dracula theme
export FZF_DEFAULT_OPTS="--height 100% --layout=reverse --border --color=fg:#f8f8f2,bg:#282a36,hl:#bd93f9 --color=fg+:#f8f8f2,bg+:#44475a,hl+:#bd93f9 --color=info:#ffb86c,prompt:#50fa7b,pointer:#ff79c6 --color=marker:#ff79c6,spinner:#ffb86c,header:#6272a4"
export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
export FZF_CTRL_T_COMMAND="${FZF_DEFAULT_COMMAND}"
alias fzfp="fzf $FZF_PREVIEW_OPTS"

# sdkman (lazy — first `sdk` / `start_java` loads it)
export SDKMAN_DIR="$HOME/.sdkman"
start_java() {
    [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
}
sdk() {
    unset -f sdk
    start_java
    sdk "$@"
}

reload() {
    source $HOME/.zshrc
}

add_to_path $HOME/.local/bin
add_to_path $HOME/.local/scripts
add_to_path $HOME/.local/.npm-global/bin
add_to_path $HOME/.cargo/bin

# if tmux is not running then start a session
# if [ -z $TMUX ]; then
#     tmux new-session -A -s default
# fi
